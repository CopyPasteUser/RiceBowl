{
  "schema_version": 5,
  "id": "heritage-workstation",
  "name": "Heritage Workstation (classic-inspired)",
  "panel": {
    "position": "bottom",
    "height": 36,
    "metrics": {"launcher_width": 88, "task_width": 148, "clock_width": 80},
    "layout": {
      "start": [
        {"type": "widget", "id": "launcher"},
        {"type": "gap", "width": 4},
        {"type": "widget", "id": "tasks"}
      ],
      "center": [],
      "end": [
        {"type": "group", "gap": 8, "children": [
          {"type": "label", "text": "WORKSTATION"},
          {"type": "widget", "id": "clock"}
        ]}
      ]
    }
  },
  "colors": {"background": "#c0c0c0", "foreground": "#18212a", "active": "#236180"},
  "menu": {"title": "Heritage Desk", "groups": [
    {"title": "Programs", "actions": ["applications", "terminal"]},
    {"title": "Session", "actions": ["lock", "logout"]}
  ]},
  "desktop": {
    "wallpaper": "classic-teal",
    "icons": [
      {"label": "Programs", "action": "applications", "x": 24, "y": 92},
      {"label": "Terminal", "action": "terminal", "x": 24, "y": 200},
      {"label": "Lock", "action": "lock", "x": 144, "y": 92}
    ]
  },
  "tokens": {"label_padding": 4, "task_radius": 0},
  "responsive": {
    "compact_max_width": 760,
    "compact_layout": {
      "start": [{"type": "widget", "id": "launcher"}],
      "center": [{"type": "widget", "id": "tasks"}],
      "end": [{"type": "widget", "id": "clock"}]
    }
  }
}
